# Classroom-Optimized Configuration
# Use this for normal classroom environments with active children

# Violence Detector - More conservative to avoid flagging normal play
VIOLENCE_MOTION_THRESHOLD=80          # Raised from 50 (less sensitive to movement)
VIOLENCE_VELOCITY_THRESHOLD=25        # Raised from 15 (faster motion required)
VIOLENCE_CONFIDENCE_THRESHOLD=0.7     # Raised from 0.5

# Direct Alert Thresholds - Higher to use more VLM validation
DIRECT_ALERT_VIOLENCE_THRESHOLD=0.80         # Raised from 0.65
DIRECT_ALERT_BODY_LANGUAGE_THRESHOLD=0.75    # Raised from 0.70
DIRECT_ALERT_DISTRESS_THRESHOLD=0.75         # Raised from 0.70

# Body Language - Keep current (already tuned)
BODY_LANGUAGE_SCORE_THRESHOLD_LOW=2.5
BODY_LANGUAGE_SCORE_THRESHOLD_HIGH=3.0

# VLM Validation Range - Wider to catch more ambiguous cases
VLM_VALIDATION_MIN_THRESHOLD=0.5
VLM_VALIDATION_VIOLENCE_MAX=0.95     # Increased from 0.90

# VLM Service Configuration (must be included)
VLM_MODEL=llava:13b
VLM_TEMPERATURE=0.3
VLM_MAX_TOKENS=500
VLM_SERVICE_PORT=8001
OLLAMA_URL=http://localhost:11434
NATS_URL=nats://localhost:4222

# Other required settings
DISTRESS_CONFIDENCE_THRESHOLD=0.5
DISTRESS_CRYING_THRESHOLD=0.7
SUPERVISION_REQUIRED_RATIO=0.25
