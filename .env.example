# ============================================================================
# NURA Childcare AI - Environment Configuration Template
# ============================================================================
# Copy this file to .env and customize values for your deployment
# cp .env.example .env

# ============================================================================
# Site Configuration
# ============================================================================
SITE_ID=nura-site-001
HTTPS_PORT=8443
LOG_LEVEL=info

# ============================================================================
# Database & Auth Passwords
# ============================================================================
POSTGRES_USER=nura
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_SECURE_PASSWORD
FRIGATE_RTSP_PASSWORD=CHANGE_ME_SECURE_PASSWORD
CLOUD_DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD
NTFY_PASSWORD=CHANGE_ME_SECURE_PASSWORD
SITE_CLAIM_CODE=dev-claim-code
CLOUD_URL=http://cloud-api
CLOUD_API_PORT=8082

# ============================================================================
# Service Version Pins
# ============================================================================
POSTGRES_VERSION=16
MOSQUITTO_VERSION=2
NATS_VERSION=2.10-alpine
KEYCLOAK_VERSION=26.0
QDRANT_VERSION=v1.12.4
NTFY_VERSION=v2.11.0
FRIGATE_VERSION=stable
CADDY_VERSION=2

# ============================================================================
# VLM Service Configuration
# ============================================================================

# VLM Model Selection
# Options: llava:13b (default), llava:7b, qwen3-vl:8b-instruct
VLM_MODEL=llava:13b
VLM_TEMPERATURE=0.3
VLM_MAX_TOKENS=500
VLM_SERVICE_PORT=8001

# Ollama Configuration
OLLAMA_URL=http://localhost:11434

# NATS Configuration (optional - for event publishing)
NATS_URL=nats://localhost:4222

# ============================================================================
# Fast-Path Detector Thresholds
# ============================================================================
# Adjust these to balance false positives vs false negatives
# Higher values = fewer false positives but may miss real violations
# Lower values = more sensitive but may have false positives

# Violence Detector
VIOLENCE_MOTION_THRESHOLD=50          # Pixel change threshold for motion detection
VIOLENCE_VELOCITY_THRESHOLD=15        # Motion velocity threshold
VIOLENCE_CONFIDENCE_THRESHOLD=0.5     # Minimum confidence to flag violence

# Distress Detector  
DISTRESS_CONFIDENCE_THRESHOLD=0.5     # Minimum confidence to flag distress
DISTRESS_CRYING_THRESHOLD=0.7         # Threshold for crying detection

# Body Language Detector (Intimidation)
# These thresholds prevent false positives on kids sitting close at desks
BODY_LANGUAGE_SCORE_THRESHOLD_LOW=2.5      # Minimum score with 2+ indicators
BODY_LANGUAGE_SCORE_THRESHOLD_HIGH=3.0     # Higher score needing 3+ indicators
BODY_LANGUAGE_INDICATOR_COUNT_LOW=2        # Indicators needed for low threshold
BODY_LANGUAGE_INDICATOR_COUNT_HIGH=3       # Indicators needed for high threshold

# Supervision Detector
SUPERVISION_REQUIRED_RATIO=0.25       # Required adult:child ratio (1:4)

# ============================================================================
# Hybrid Routing Decision Thresholds
# ============================================================================
# Control when to use fast-path vs VLM validation

# Direct Alert Thresholds (fast-path only, ~2-5s response)
# Violations above these thresholds trigger immediate alerts without VLM
DIRECT_ALERT_VIOLENCE_THRESHOLD=0.65         # Violence confidence for direct alert
DIRECT_ALERT_BODY_LANGUAGE_THRESHOLD=0.70    # Body language confidence for direct alert
DIRECT_ALERT_DISTRESS_THRESHOLD=0.70         # Distress confidence for direct alert
DIRECT_ALERT_SUPERVISION_THRESHOLD=0.80      # Supervision confidence for direct alert

# VLM Validation Thresholds (medium confidence range, ~20-30s response)
# Violations in this range get VLM validation before alerting
VLM_VALIDATION_MIN_THRESHOLD=0.5             # Minimum confidence to trigger VLM
VLM_VALIDATION_VIOLENCE_MAX=0.9              # Max before direct alert (above = direct)
VLM_VALIDATION_BODY_LANGUAGE_MAX=0.85        # Max before direct alert
VLM_VALIDATION_DISTRESS_MAX=0.85             # Max before direct alert

# ============================================================================
# Logging and Performance
# ============================================================================

# Log Level (DEBUG, INFO, WARNING, ERROR)
VLM_LOG_LEVEL=INFO

# Request Timeouts (seconds)
VLM_REQUEST_TIMEOUT=180               # VLM analysis timeout
OLLAMA_REQUEST_TIMEOUT=180            # Ollama API timeout
