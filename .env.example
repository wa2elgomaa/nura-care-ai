# Copy to .env and change every password. Dev values only.
SITE_ID=dev-site-001
HTTPS_PORT=8443
LOG_LEVEL=info

POSTGRES_USER=nura
POSTGRES_PASSWORD=change-me-dev-only
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-dev-only
FRIGATE_RTSP_PASSWORD=change-me-dev-only
CLOUD_DB_PASSWORD=change-me-dev-only
SITE_CLAIM_CODE=dev-claim-code
CLOUD_URL=http://cloud-api
CLOUD_API_PORT=8082

# Version pins (check current releases before real use)
POSTGRES_VERSION=16
MOSQUITTO_VERSION=2
NATS_VERSION=2.10-alpine
KEYCLOAK_VERSION=26.0
QDRANT_VERSION=v1.12.4
NTFY_VERSION=v2.11.0
FRIGATE_VERSION=stable
CADDY_VERSION=2
# APPRISE_VERSION=latest
# OLLAMA_VERSION=latest
# MEDIAMTX_VERSION=latest
# MAILPIT_VERSION=latest

# NURA service images (leave unset to use the whoami placeholder)
# NURA_API_IMAGE=ghcr.io/your-org/nura-api:dev
# NURA_UI_IMAGE=ghcr.io/your-org/nura-ui:dev
# NURA_PERCEPTION_IMAGE=ghcr.io/your-org/nura-perception:dev
# NURA_SENSOR_ADAPTER_IMAGE=ghcr.io/your-org/nura-sensor-adapter:dev
# NURA_RULES_IMAGE=ghcr.io/your-org/nura-rules:dev
# NURA_RAG_IMAGE=ghcr.io/your-org/nura-rag:dev
# NURA_NOTIFIER_IMAGE=ghcr.io/your-org/nura-notifier:dev
# NURA_SYNC_AGENT_IMAGE=ghcr.io/your-org/nura-sync-agent:dev
# CLOUD_API_IMAGE=ghcr.io/your-org/nura-cloud-api:dev
# ALERT_RELAY_IMAGE=ghcr.io/your-org/nura-alert-relay:dev

# RuView (profile: sensing) - copy the image name from the RuView README
# RUVIEW_IMAGE=
# EMBEDDING_MODEL=bge-m3
