SITE_ID=nura-site-001
HTTPS_PORT=8443
LOG_LEVEL=info

POSTGRES_USER=nura
POSTGRES_PASSWORD=Pa$$w0rd!
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=Pa$$w0rd!
FRIGATE_RTSP_PASSWORD=Pa$$w0rd!
CLOUD_DB_PASSWORD=Pa$$w0rd!
NTFY_PASSWORD=Pa$$w0rd!
SITE_CLAIM_CODE=dev-claim-code
CLOUD_URL=http://cloud-api
CLOUD_API_PORT=8082

# Version pins (check current releases before real use)
POSTGRES_VERSION=16
MOSQUITTO_VERSION=2
NATS_VERSION=2.10-alpine
KEYCLOAK_VERSION=26.0
QDRANT_VERSION=v1.12.4
NTFY_VERSION=v2.11.0
FRIGATE_VERSION=stable
CADDY_VERSION=2
# APPRISE_VERSION=latest
# OLLAMA_VERSION=latest
# MEDIAMTX_VERSION=latest
# MAILPIT_VERSION=latest

# NURA service images (leave unset to use the whoami placeholder)
# NURA_API_IMAGE=ghcr.io/your-org/nura-api:dev
# NURA_UI_IMAGE=ghcr.io/your-org/nura-ui:dev
# NURA_PERCEPTION_IMAGE=ghcr.io/your-org/nura-perception:dev
# NURA_SENSOR_ADAPTER_IMAGE=ghcr.io/your-org/nura-sensor-adapter:dev
# NURA_RULES_IMAGE=ghcr.io/your-org/nura-rules:dev
# NURA_RAG_IMAGE=ghcr.io/your-org/nura-rag:dev
# NURA_NOTIFIER_IMAGE=ghcr.io/your-org/nura-notifier:dev
# NURA_SYNC_AGENT_IMAGE=ghcr.io/your-org/nura-sync-agent:dev
# CLOUD_API_IMAGE=ghcr.io/your-org/nura-cloud-api:dev
# ALERT_RELAY_IMAGE=ghcr.io/your-org/nura-alert-relay:dev

# RuView (profile: sensing) - copy the image name from the RuView README
# RUVIEW_IMAGE=
# EMBEDDING_MODEL=bge-m3

UPDATE_SIGNING_KEY_FILE=./nura-signing-key.pem


# ============================================================================
# VLM Service Configuration
# ============================================================================

# VLM Model Selection
VLM_MODEL=llava:13b
VLM_TEMPERATURE=0.3
VLM_MAX_TOKENS=500
VLM_SERVICE_PORT=8001

# Ollama Configuration
OLLAMA_URL=http://localhost:11434

# NATS Configuration (optional - for event publishing)
NATS_URL=nats://localhost:4222

# ============================================================================
# Fast-Path Detector Thresholds
# ============================================================================

# Violence Detector
VIOLENCE_MOTION_THRESHOLD=50
VIOLENCE_VELOCITY_THRESHOLD=15
VIOLENCE_CONFIDENCE_THRESHOLD=0.5

# Distress Detector
DISTRESS_CONFIDENCE_THRESHOLD=0.5
DISTRESS_CRYING_THRESHOLD=0.7

# Body Language Detector (Intimidation)
BODY_LANGUAGE_SCORE_THRESHOLD_LOW=2.5
BODY_LANGUAGE_SCORE_THRESHOLD_HIGH=3.0
BODY_LANGUAGE_INDICATOR_COUNT_LOW=2
BODY_LANGUAGE_INDICATOR_COUNT_HIGH=3

# Supervision Detector
SUPERVISION_REQUIRED_RATIO=0.25

# ============================================================================
# Hybrid Routing Decision Thresholds
# ============================================================================

# Direct Alert Thresholds (fast-path only, no VLM validation)
DIRECT_ALERT_VIOLENCE_THRESHOLD=0.65
DIRECT_ALERT_BODY_LANGUAGE_THRESHOLD=0.70
DIRECT_ALERT_DISTRESS_THRESHOLD=0.70
DIRECT_ALERT_SUPERVISION_THRESHOLD=0.80

# VLM Validation Thresholds (medium confidence range)
VLM_VALIDATION_MIN_THRESHOLD=0.5
VLM_VALIDATION_VIOLENCE_MAX=0.9
VLM_VALIDATION_BODY_LANGUAGE_MAX=0.85
VLM_VALIDATION_DISTRESS_MAX=0.85

# ============================================================================
# Logging and Performance
# ============================================================================

# Log Level (DEBUG, INFO, WARNING, ERROR)
VLM_LOG_LEVEL=INFO

# Request Timeouts (seconds)
VLM_REQUEST_TIMEOUT=180
OLLAMA_REQUEST_TIMEOUT=180