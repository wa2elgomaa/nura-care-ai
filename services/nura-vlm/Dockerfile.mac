# =============================================================================
# VLM Service - Mac M4 Max Optimized
#
# Optimizations:
# - Uses native macOS Ollama via host.docker.internal (Metal GPU)
# - Lightweight container (just Python service)
# - No GPU passthrough needed
# =============================================================================

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy shared detectors package first
COPY ./packages/nura-detectors /app/packages/nura-detectors

# Copy requirements
COPY ./services/nura-vlm/requirements.txt .

# Install Python dependencies (including shared package)
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY ./services/nura-vlm/src/ ./src/

# Create directories for images
RUN mkdir -p /tmp/vlm_images

# Expose port
EXPOSE 8001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# Run the service
CMD ["python", "-m", "src.main"]
