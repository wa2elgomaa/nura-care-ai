# =============================================================================
# RAG Service - GPU Optimized (NVIDIA CUDA)
#
# Optimizations:
# - GPU-accelerated embeddings with transformers
# - CUDA support for faster vector operations
# - Larger batch processing
# =============================================================================

FROM node:20-slim

WORKDIR /app

# Install system dependencies for GPU operations
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy package files
COPY package*.json ./

# Install Node.js dependencies
RUN npm ci --only=production

# Install Python dependencies for GPU-accelerated embeddings (if needed)
# RUN pip3 install --no-cache-dir torch transformers --index-url https://download.pytorch.org/whl/cu121

# Copy source code
COPY src/ ./src/
COPY tsconfig.json ./

# Build TypeScript
RUN npm run build

# Expose port
EXPOSE 3002

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:3002/health || exit 1

# Run the service
CMD ["node", "dist/main.js"]
